[Unit]
Description=Technitium DNS query event producer
After=dnsserver-quadlet.service
Requires=dnsserver-quadlet.service

[Container]
Image=docker.io/library/python:3.12-alpine@sha256:b64631e04e4920160c50fbe8d8df828f7f35f06f425cb44aa09bca53e708a35a
ContainerName=query-events
User=1000:1000
UserNS=keep-id
Environment=DNS_LOG_DIR=/logs
Environment=EVENTS_OUT=/data/query-events.jsonl
Environment=EVENTS_STATE=/data/query-events.state.json
Environment=POLL_SECONDS=2
Exec=python3 /opt/producer/technitium_query_producer.py
SecurityLabelDisable=true
Volume=/home/doom/dns-logs:/logs:ro,Z
Volume=/home/doom/dns-stats:/data:Z
Volume=/home/doom/observability/technitium_query_producer.py:/opt/producer/technitium_query_producer.py:ro,Z

[Service]
Restart=always
MemoryMax=32M
CPUQuota=10%

[Install]
WantedBy=default.target
