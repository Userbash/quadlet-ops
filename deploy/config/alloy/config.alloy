logging {
  level  = "info"
  format = "logfmt"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Container streams are selected by journald's CONTAINER_NAME field and given
// stable low-cardinality labels. Includes the complete Nextcloud stack.
loki.source.journal "open_webui" {
  matches    = "CONTAINER_NAME=open-webui"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "open-webui", container = "open-webui"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "three_x_ui" {
  matches    = "CONTAINER_NAME=3xui_app"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "3x-ui", container = "3xui_app"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "portainer" {
  matches    = "CONTAINER_NAME=portainer"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "portainer", container = "portainer"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "nextcloud_app" {
  matches    = "CONTAINER_NAME=nextcloud_app_1"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "nextcloud", container = "nextcloud_app_1"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "nextcloud_cron" {
  matches    = "CONTAINER_NAME=nextcloud_cron_1"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "nextcloud", container = "nextcloud_cron_1"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "nextcloud_db" {
  matches    = "CONTAINER_NAME=nextcloud_db_1"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "nextcloud", container = "nextcloud_db_1"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "nextcloud_redis" {
  matches    = "CONTAINER_NAME=nextcloud_redis_1"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "nextcloud", container = "nextcloud_redis_1"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "nextcloud_rabbitmq" {
  matches    = "CONTAINER_NAME=nextcloud_rabbitmq_1"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "container", service = "nextcloud", container = "nextcloud_rabbitmq_1"}
  forward_to = [loki.write.local.receiver]
}

// Security events from Fail2Ban.
loki.source.journal "fail2ban" {
  matches    = "SYSLOG_IDENTIFIER=fail2ban"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "security", service = "fail2ban"}
  forward_to = [loki.write.local.receiver]
}

// UFW firewall blocks are emitted by the kernel transport. The stream also
// contains other kernel/network messages; filter UFW entries in LogQL with
// |= "UFW BLOCK" to avoid relying on journal wildcard syntax.
loki.source.journal "ufw" {
  matches    = "_TRANSPORT=kernel"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "security", service = "kernel-firewall-network"}
  forward_to = [loki.write.local.receiver]
}

// Network-manager and systemd-networkd events.
loki.source.journal "network_manager" {
  matches    = "SYSLOG_IDENTIFIER=NetworkManager"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "network", service = "networkmanager"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "systemd_networkd" {
  matches    = "SYSLOG_IDENTIFIER=systemd-networkd"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "network", service = "systemd-networkd"}
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "network_dispatcher" {
  matches    = "SYSLOG_IDENTIFIER=networkd-dispatcher"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "network", service = "networkd-dispatcher"}
  forward_to = [loki.write.local.receiver]
}

// Fail2Ban writes jail activity to /var/log/fail2ban.log. The jail name is
// extracted as a label so all four jails can be queried independently.
local.file_match "fail2ban" {
  path_targets = [{
    __path__ = "/var/log/fail2ban.log",
    job = "security",
    service = "fail2ban",
  }]
}

loki.process "fail2ban" {
  forward_to = [loki.write.local.receiver]

  stage.regex {
    expression = `.*(?:INFO|NOTICE|WARNING)\s+\[(?P<jail>[A-Za-z][A-Za-z0-9_.-]*)\]\s+(?P<event>Restore Ban|Ban|Unban|Found)\b.*`
  }
  stage.labels {
    values = {jail = "", event = ""}
  }
  stage.metrics {
    metric.counter {
      name = "fail2ban_jail_events_total"
      prefix = "node2_"
      description = "Fail2Ban Ban, Unban, and Found events by jail; source IP is not a label"
      source = "event"
      action = "inc"
      max_idle_duration = "24h"
    }
  }
}

loki.source.file "fail2ban" {
  targets    = local.file_match.fail2ban.targets
  forward_to = [loki.process.fail2ban.receiver]
}

// SSH authentication events used by the sshd jail.
loki.source.journal "sshd_fail2ban" {
  matches    = "_SYSTEMD_UNIT=sshd.service"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "security", service = "sshd", jail = "sshd"}
  forward_to = [loki.write.local.receiver]
}

// Nginx reverse-proxy access/error logs. Rotated *.1 files are intentionally
// excluded to avoid re-ingesting the existing history on deployment.
local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/*.log",
    job = "nginx",
    service = "reverse-proxy",
  }, {
    __path__ = "/var/log/nginx/*.log.1",
    job = "nginx",
    service = "reverse-proxy",
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.process.nginx_499.receiver]
}

// Derive a Prometheus counter from DoH client-aborted requests.
loki.process "nginx_499" {
  forward_to = [loki.write.local.receiver]

  stage.regex {
    expression = `^(?P<client_ip>\S+) .*?"(?:GET|POST) /dns-query[^"]*" (?P<status>\d{3}) `
  }

  stage.labels { values = {status = ""} }

  stage.metrics {
    metric.counter {
      name = "nginx_doh_2xx_total"
      description = "DoH HTTP 2xx responses"
      source = "status"
      value = "200"
      action = "inc"
    }
    metric.counter {
      name = "nginx_doh_3xx_total"
      description = "DoH HTTP 3xx responses"
      source = "status"
      value = "300"
      action = "inc"
    }
    metric.counter {
      name = "nginx_doh_4xx_total"
      description = "DoH HTTP 4xx responses"
      source = "status"
      value = "400"
      action = "inc"
    }
    metric.counter {
      name = "nginx_doh_5xx_total"
      description = "DoH HTTP 5xx responses"
      source = "status"
      value = "500"
      action = "inc"
    }
    metric.counter {
      name = "nginx_doh_499_total"
      description = "DoH HTTP 499 client-aborted responses"
      source = "status"
      value = "499"
      action = "inc"
    }
  }
}

  local.file_match "dnsserver" {
    path_targets = [{
      __path__ = "/var/log/technitium/dns/*.log",
      job = "container",
      service = "dnsserver",
      container = "dnsserver",
    }]
  }

loki.source.file "dnsserver" {
    targets = local.file_match.dnsserver.targets
    forward_to = [loki.process.dns_events.receiver]
  }

// Normalized per-query events: one JSON object per line with timestamp,
// domain, source (cached|recursive|...), query_type and optional event_id.
// Domain remains in the log body to avoid high-cardinality Loki labels.
local.file_match "dns_query_events" {
  path_targets = [{
    __path__ = "/var/lib/dns-stats/query-events.jsonl",
    job = "dns-statistics",
    service = "tihorium",
    component = "query-event",
  }]
}

loki.process "dns_query_events" {
  forward_to = [loki.write.local.receiver]
  stage.json {
    expressions = {source = "source", query_type = "query_type"}
  }
  stage.labels { values = {source = "", query_type = ""} }
}

loki.source.file "dns_query_events" {
  targets = local.file_match.dns_query_events.targets
  forward_to = [loki.process.dns_query_events.receiver]
}

// Technitium container stdout/stderr: startup, cache, query, warning and error events.
loki.source.journal "dnsserver_container" {
  matches    = "CONTAINER_NAME=dnsserver"
  max_age    = "72h"
  path       = "/var/log/journal"
  labels     = {job = "dns", service = "tihorium", component = "dnsserver", container = "dnsserver"}
  forward_to = [loki.process.dns_events.receiver]
}

loki.source.journal "dnsserver_panel_proxy" {
  matches    = "CONTAINER_NAME=dnsserver-panel-proxy"
  max_age    = "72h"
  path       = "/var/log/journal"
  labels     = {job = "dns", service = "tihorium", component = "panel-proxy", container = "dnsserver-panel-proxy"}
  forward_to = [loki.write.local.receiver]
}

loki.process "dns_events" {
  forward_to = [loki.write.local.receiver]
  stage.regex {
    expression = `(?i).*?(?P<event_level>error|warn(?:ing)?|fail(?:ed|ure)?|cache|query|dnssec|blocked|recursive|timeout).*`
  }
  stage.labels { values = {event_level = ""} }
}

// Hourly/daily Technitium query-statistics snapshots produced by the
// rootless dns-stats collector. JSON lines are retained in Loki for analysis.
local.file_match "dns_stats" {
  path_targets = [{
    __path__ = "/var/lib/dns-stats/*.jsonl",
    job = "dns-statistics",
    service = "tihorium",
    component = "query-stats",
  }]
}

loki.source.file "dns_stats" {
  targets    = local.file_match.dns_stats.targets
  forward_to = [loki.write.local.receiver]
}
// BEGIN NODE2_METRICS_MANAGED
// Metrics from Nginx's privacy-minimized access logs and the rootless
// node2-capacity-metrics user service.
prometheus.remote_write "node2" {
  endpoint {
    url = "http://victoria-metrics:8428/api/v1/write"
  }
}

prometheus.scrape "alloy_self" {
  targets = [{"__address__" = "127.0.0.1:12345"}]
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.node2.receiver]
}

local.file_match "nginx_metrics" {
  path_targets = [
    {__path__ = "/var/log/nginx/metrics/nextcloud.log", job = "nginx_metrics", service = "nextcloud"},
    {__path__ = "/var/log/nginx/metrics/xhttp.log", job = "nginx_metrics", service = "xhttp"},
    {__path__ = "/var/log/nginx/metrics/doh.log", job = "nginx_metrics", service = "doh"},
    {__path__ = "/var/log/nginx/metrics/xui_panel.log", job = "nginx_metrics", service = "xui_panel"},
  ]
}

loki.source.file "nginx_metrics" {
  targets    = local.file_match.nginx_metrics.targets
  forward_to = [loki.process.nginx_metrics.receiver]
}

local.file_match "nginx_incident" {
  path_targets = [{
    __path__ = "/var/log/nginx/incident-correlation/nextcloud.log",
    job = "nginx_incident",
    service = "nextcloud",
  }]
}

loki.source.file "nginx_incident" {
  targets    = local.file_match.nginx_incident.targets
  forward_to = [loki.write.local.receiver]
}

loki.process "nginx_metrics" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      status = "status",
      request_time = "request_time",
      request_length = "request_length",
      bytes_sent = "bytes_sent",
      limit_req = "limit_req",
      limit_conn = "limit_conn",
    }
  }

  stage.labels {
    values = {
      status = "",
      limit_req = "",
      limit_conn = "",
    }
  }

  stage.metrics {
    metric.counter {
      name = "nginx_http_requests_total"
      prefix = "node2_"
      description = "Completed Nginx requests by service, status, and limit decision"
      source = "status"
      action = "inc"
      max_idle_duration = "1h"
    }

    metric.histogram {
      name = "nginx_request_duration_seconds"
      prefix = "node2_"
      description = "Completed Nginx request duration"
      source = "request_time"
      buckets = [0.1, 0.25, 0.5, 1, 2, 5, 10, 30, 60, 120, 300, 3600]
      max_idle_duration = "1h"
    }

    metric.histogram {
      name = "nginx_request_body_bytes"
      prefix = "node2_"
      description = "Incoming Nginx request size including headers"
      source = "request_length"
      buckets = [1024, 16384, 1048576, 10485760, 104857600, 1073741824, 10737418240, 68719476736]
      max_idle_duration = "1h"
    }

    metric.histogram {
      name = "nginx_response_body_bytes"
      prefix = "node2_"
      description = "Nginx response body size"
      source = "bytes_sent"
      buckets = [1024, 16384, 1048576, 10485760, 1073741824, 10737418240, 68719476736]
      max_idle_duration = "1h"
    }
  }
}

loki.source.journal "node2_capacity_metrics" {
  matches    = "SYSLOG_IDENTIFIER=node2-capacity-metrics"
  max_age    = "24h"
  path       = "/var/log/journal"
  labels     = {job = "node2_metrics", instance = "node2"}
  forward_to = [loki.process.node2_capacity_metrics.receiver]
}

loki.process "node2_capacity_metrics" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      cpu_busy_ratio = "cpu_busy_ratio",
      cpu_iowait_ratio = "cpu_iowait_ratio",
      cpu_sample_valid = "cpu_sample_valid",
      memory_total_bytes = "memory_total_bytes",
      memory_available_bytes = "memory_available_bytes",
      load1 = "load1",
      root_size_bytes = "root_size_bytes",
      root_used_bytes = "root_used_bytes",
      root_available_bytes = "root_available_bytes",
      nextcloud_storage_up = "nextcloud_storage_up",
      nextcloud_size_bytes = "nextcloud_size_bytes",
      nextcloud_used_bytes = "nextcloud_used_bytes",
      nextcloud_available_bytes = "nextcloud_available_bytes",
      nextcloud_http_up = "nextcloud_http_up",
      nextcloud_container_running = "nextcloud_container_running",
      nextcloud_container_stats_up = "nextcloud_container_stats_up",
      nextcloud_container_cpu_ratio = "nextcloud_container_cpu_ratio",
      nextcloud_container_memory_bytes = "nextcloud_container_memory_bytes",
      xui_container_running = "xui_container_running",
      xui_container_stats_up = "xui_container_stats_up",
      xui_container_cpu_ratio = "xui_container_cpu_ratio",
      xui_container_memory_bytes = "xui_container_memory_bytes",
      nginx_status_up = "nginx_status_up",
      nginx_active_connections = "nginx_active_connections",
      nginx_reading_connections = "nginx_reading_connections",
      nginx_writing_connections = "nginx_writing_connections",
      nginx_waiting_connections = "nginx_waiting_connections",
      nginx_accepted_connections = "nginx_accepted_connections",
      nginx_handled_connections = "nginx_handled_connections",
      nginx_total_requests = "nginx_total_requests",
      nginx_connection_capacity = "nginx_connection_capacity",
      nginx_established_443 = "nginx_established_443",
      nginx_syn_recv_443 = "nginx_syn_recv_443",
      tcp_listen_overflows_total = "tcp_listen_overflows_total",
      tcp_listen_drops_total = "tcp_listen_drops_total",
      tcp_syncookies_sent_total = "tcp_syncookies_sent_total",
      tcp_backlog_drops_total = "tcp_backlog_drops_total",
      conntrack_entries = "conntrack_entries",
      conntrack_limit = "conntrack_limit",
    }
  }

  stage.metrics {
    metric.gauge {
      name = "cpu_busy_ratio"
      prefix = "node2_"
      source = "cpu_busy_ratio"
      action = "set"
    }
    metric.gauge {
      name = "cpu_iowait_ratio"
      prefix = "node2_"
      source = "cpu_iowait_ratio"
      action = "set"
    }
    metric.gauge {
      name = "cpu_sample_valid"
      prefix = "node2_"
      source = "cpu_sample_valid"
      action = "set"
    }
    metric.gauge {
      name = "memory_total_bytes"
      prefix = "node2_"
      source = "memory_total_bytes"
      action = "set"
    }
    metric.gauge {
      name = "memory_available_bytes"
      prefix = "node2_"
      source = "memory_available_bytes"
      action = "set"
    }
    metric.gauge {
      name = "load1"
      prefix = "node2_"
      source = "load1"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_size_bytes"
      prefix = "node2_root_"
      source = "root_size_bytes"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_used_bytes"
      prefix = "node2_root_"
      source = "root_used_bytes"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_available_bytes"
      prefix = "node2_root_"
      source = "root_available_bytes"
      action = "set"
    }
    metric.gauge {
      name = "storage_scrape_success"
      prefix = "node2_nextcloud_"
      source = "nextcloud_storage_up"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_size_bytes"
      prefix = "node2_nextcloud_"
      source = "nextcloud_size_bytes"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_used_bytes"
      prefix = "node2_nextcloud_"
      source = "nextcloud_used_bytes"
      action = "set"
    }
    metric.gauge {
      name = "filesystem_available_bytes"
      prefix = "node2_nextcloud_"
      source = "nextcloud_available_bytes"
      action = "set"
    }
    metric.gauge {
      name = "http_status_up"
      prefix = "node2_nextcloud_"
      source = "nextcloud_http_up"
      action = "set"
    }
    metric.gauge {
      name = "application_container_running"
      prefix = "node2_nextcloud_"
      source = "nextcloud_container_running"
      action = "set"
    }
    metric.gauge {
      name = "application_container_stats_up"
      prefix = "node2_nextcloud_"
      source = "nextcloud_container_stats_up"
      action = "set"
    }
    metric.gauge {
      name = "application_container_cpu_ratio"
      prefix = "node2_nextcloud_"
      source = "nextcloud_container_cpu_ratio"
      action = "set"
    }
    metric.gauge {
      name = "application_container_memory_bytes"
