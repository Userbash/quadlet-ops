# Copy to .env and chmod 600 .env. Never commit the real file.
NODE2_HOST=node2
NODE2_USER=root
# NODE2_SSH_KEY=/home/user/.ssh/id_ed25519
NODE2_DOMAIN=node2.example.com
LETSENCRYPT_EMAIL=admin@example.com
NODE2_WEB_ROOT=/var/www/node2
NODE2_XUI_PANEL_PATH=replace-with-random-panel-path
NODE2_DNS_PANEL_PATH=replace-with-random-dns-panel-path
NODE2_DNS_ALLOWED_CIDR=127.0.0.1/32
NODE2_PANEL_USER=admin
# Required for Nginx Basic Auth in front of the 3X-UI panel.
NODE2_PANEL_PASSWORD=replace-this-password
# Optional, leave unset unless the Technitium API token is provisioned.
# NODE2_TECHNITIUM_API_TOKEN=
BACKUP_ROOT=backups
DEPLOY_CONFIRM=NO
